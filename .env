# Hostname  /etc/hosts&/etc/hostname
HOSTNAME='Rpi200-SuperNun02'

# Grafana /usr/env/device.env
EDGE_CLUSTER='dev'
EDGE_ID='SuperNun02'
EDGE_STATION='SuperNun02'
EDGE_NUMBER='2'
CONFIG_DOWNLOAD_TOKEN='secret'
GIT_USER='secret'
GIT_PASS='secret'

# /usr/env/iotmonitor.env
DOTENVENC_PASS='secret_password'
DOCKER=0


#RPORT /home/ds/rport/rport.conf
RPORT_SERVER = "secret"
RPORT_AUTH = "Rpi200-SuperNun02:secret_password"
RPORT_USE_SYSTEM_ID = "true"
RPORT_USE_HOSTNAME = "false"
RPORT_NAME = "Rpi200-SuperNun02"
RPORT_TAGES = ['test', 'dev', 'edgebox', 'v2']
RPORT_ALLOW_ROOT = "true"
RPORT_DATA_DIR = "/home/ds/rport"
    # [connection]
RPORT_KEEP_ALIVE = "3m"
RPORT_MAX_RETRY_INTERVAL = "3m"
RPORT_WATCHDOG_INTEGRATION = "true"
    # [logging]
RPORT_LOG_FILE = "/home/ds/rport/rport.log"
RPORT_LOG_LEVEL = "debug"
    # [remote-commands]
    # [remote-scripts]
RPORT_ENABLED_REMOTE = "true"
    # [monitoring]
RPORT_ENABLED_MONITOR = "true"
RPORT_PM_ENABLED = "true"
    # [interpreter-aliases]
    # [file-reception]
